<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>

    <logger name="com.jtspringproject.JtSpringProject.controller" level="INFO"/>
    <logger name="com.jtspringproject.JtSpringProject.services" level="INFO"/>
    <logger name="com.jtspringproject.JtSpringProject.dao" level="DEBUG"/>
    <logger name="com.jtspringproject.JtSpringProject.configuration" level="INFO"/>
    <logger name="com.jtspringproject.JtSpringProject" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
